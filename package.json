{
  "name": "hunting-hub",
  "productName": "Hunting Hub",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win --publish never",
    "icon": "electron scripts/make-icon.cjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "@turf/area": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "firebase": "^13.1.0",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^6.16.0",
    "piexifjs": "^1.0.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Map, plan and log hunts on your property.",
  "author": "JohnA",
  "build": {
    "appId": "com.huntinghub.app",
    "productName": "Hunting Hub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fenceline",
      "artifactName": "Hunting-Hub-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "jappelbaum99-cmyk",
      "repo": "hunting-app"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "onnxruntime-node": "^1.31.1"
  }
}
